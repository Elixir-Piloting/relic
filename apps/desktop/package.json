{
  "name": "@relic/desktop",
  "version": "0.1.0",
  "private": true,
  "main": "dist/main.js",
  "author": {
    "name": "Relic Team",
    "email": "contact@relic.dev"
  },
  "homepage": "https://github.com/relic/database-admin",
  "description": "Relic Database Admin - Desktop App",
  "scripts": {
    "dev": "pnpm run compile && concurrently \"pnpm run dev:next\" \"wait-on http://localhost:3000 && electron . --no-sandbox\"",
    "dev:next": "pnpm --filter @relic/web dev",
    "build": "pnpm run build:next && pnpm run build:electron",
    "build:next": "pnpm --filter @relic/web build:electron",
    "build:electron": "pnpm run compile && electron-builder --config electron-builder.config.js",
    "start": "pnpm run compile && electron .",
    "lint": "eslint",
    "compile": "tsc"
  },
  "dependencies": {
    "@relic/shared": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "concurrently": "^9.0.0",
    "electron": "^30.5.1",
    "electron-builder": "^24.13.3",
    "typescript": "^5",
    "wait-on": "^8.0.0"
  }
}
